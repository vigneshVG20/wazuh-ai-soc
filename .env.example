# Wazuh indexer connection
WAZUH_INDEXER_URL=https://wazuh-indexer.example:9200
WAZUH_USERNAME=your_wazuh_username
WAZUH_PASSWORD=your_wazuh_password
WAZUH_INDEX_PATTERN=wazuh-alerts-4.x-*

# Alert-processing thresholds
ALERT_LEVEL=5
CRITICAL_EMAIL_LEVEL=10
POLL_INTERVAL=30

# Ollama service used for alert analysis
OLLAMA_URL=http://your-ollama-host:11434
OLLAMA_MODEL=your_model_name

# SMTP delivery for generated reports
SMTP_SERVER=smtp.gmail.com
SMTP_PORT=587
SENDER_EMAIL=sender@example.com
SENDER_APP_PASSWORD=your_smtp_app_password
ADMIN_EMAIL=soc-admin@example.com
